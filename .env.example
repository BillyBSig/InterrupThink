# Personal keys for live case CLI only. Not required for dummy examples
# or `from interrupthink import ...`. Do not commit a filled .env.
#
# Copy to .env. Fill only when a live model run is needed.

# Specialist — LiveLlm (visible XML steps, not hidden chain-of-thought)
LLM_MODEL=gpt-5.6-luna
LLM_REASONING_EFFORT=none
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1

# Supervisor — LlmMonitor (on-demand; default Unknown)
SUPERVISOR_MODEL=gpt-5.6-luna
SUPERVISOR_REASONING_EFFORT=medium
SUPERVISOR_API_KEY=
SUPERVISOR_BASE_URL=https://api.openai.com/v1

# Shared OpenAI key (used if LLM_API_KEY / SUPERVISOR_API_KEY empty)
OPENAI_API_KEY=
